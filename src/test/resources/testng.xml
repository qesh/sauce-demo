<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  data-provider-thread-count = number of scenarios run in parallel per runner.
  Each UI scenario gets its own browser (ThreadLocal driver), so raise it with care.
-->
<suite name="QA Automation Regression" data-provider-thread-count="3" verbose="1">

    <test name="API Tests">
        <classes>
            <class name="com.framework.runners.ApiTestRunner"/>
        </classes>
    </test>

    <test name="UI Tests">
        <classes>
            <class name="com.framework.runners.UiTestRunner"/>
        </classes>
    </test>

</suite>
